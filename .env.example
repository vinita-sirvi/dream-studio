# Divya & Design — environment variables
#
# Copy to `.env.local` for development, or set these in your hosting provider.
# Every value is read through `lib/env.ts`.

# ─── Required in production ───────────────────────────────────────────────────

# Signs the session cookie. There is NO fallback in production: the server throws
# rather than sign sessions with a guessable key, because a known secret lets
# anyone forge a cookie for `role: "super_admin"`.
#   Generate with:  openssl rand -base64 32
SESSION_SECRET=

# MongoDB connection string. Without it the storefront falls back to the bundled
# demo catalogue and no cart, order or account data can be stored.
MONGODB_URI=
# Optional: database name, when not already in the URI.
MONGODB_DB=

# Absolute public URL, no trailing slash. Used for canonical URLs, the sitemap,
# and the links in order emails.
APP_URL=https://example.com

# ─── Admin access ─────────────────────────────────────────────────────────────

# Comma-separated addresses that (a) receive contact-form and commission
# notifications and (b) are promoted to the `admin` role on first sign-in.
#
# This is the supported way to create the first admin. The demo seed is the only
# other source of an admin account and it never runs in production — it uses
# credentials committed to this repository.
ADMIN_EMAILS=owner@example.com

# ─── Email (Resend) ───────────────────────────────────────────────────────────

# Without these, email sending is skipped silently: OTP login codes are never
# delivered, so password sign-in is the only route in.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Media uploads (Cloudinary) ───────────────────────────────────────────────

# Server-side credentials, preferred. Uploads are admin-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fallback for unsigned uploads when no API key/secret is set.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Development conveniences ─────────────────────────────────────────────────

# Writes the bundled demo catalogue on first read. Automatic outside production.
# Setting this to `true` in production seeds demo *products* only — demo user
# accounts are never created there.
# SEED_DEMO_DATA=true
